---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { d2lAssets as d2l } from '../../data/d2l-assets';
import { appleRingAssets as ring } from '../../data/apple-ring-assets';
import { communityAssets as community } from '../../data/community-spaces-assets';
import portrait from '../../assets/personal/suleyman-portrait.jpg';
import align from '../../assets/align/discovery.png';
import alignSummary from '../../assets/align/summary.png';
import { site } from '../../data/site';
import '../../experiments/through-my-lens/lens.css';
import '../../experiments/through-my-lens/d2l-world.css';
---
<BaseLayout title="Through My Lens — Suleyman Koncagul / experimental portfolio" description="An isolated interactive portfolio experiment. Four perspectives on UX and product design, by Suleyman Koncagul." noindex>
<div class="lens-experiment" data-lens-experience>
  <header class="lens-nav"><a class="lens-wordmark" href="#intro">SK<span> / THROUGH MY LENS</span></a><nav aria-label="Experiment navigation"><a href="#projects">View projects <span aria-hidden="true">↘</span></a><a href="#person">The person</a><a href="/">Editorial portfolio ↗</a></nav></header>
  <main id="main" tabindex="-1">
    <section class="lens-journey" id="intro" aria-labelledby="lens-headline">
      <div class="lens-stage">
        <div class="lens-hero-copy"><p class="lens-label">Suleyman Koncagul <span>UX / Product Designer</span></p><h1 id="lens-headline">Experience<br/>is a matter of<br/><em>perspective.</em></h1><p class="lens-intro-text">I turn complex information into clear,<br class="desktop-break"/> thoughtful, working experiences.</p><a class="lens-link" href="#projects">Skip introduction <span aria-hidden="true">↓</span></a></div>
        <div class="lens-object" data-glasses-host>
          <svg class="lens-fallback" viewBox="0 0 800 400" role="img" aria-label="Thin metal glasses, a symbol of perspective"><defs><linearGradient id="frame-metal" x2="1" y2="1"><stop stop-color="#fff5dd"/><stop offset=".3" stop-color="#706a60"/><stop offset=".7" stop-color="#c1c6c7"/><stop offset="1" stop-color="#575d65"/></linearGradient></defs><g fill="#d6e6ed" fill-opacity=".04" stroke="url(#frame-metal)" stroke-width="4"><rect x="95" y="140" width="270" height="170" rx="65"/><rect x="435" y="140" width="270" height="170" rx="65"/><path d="M365 177Q400 151 435 177M95 170L180 65M705 170L740 62" fill="none"/></g></svg>
          <canvas data-glasses-canvas aria-hidden="true"></canvas>
        </div>
        
        <div class="lens-tools" data-3d-tools hidden>
          <div class="lens-material" role="group" aria-label="Lens material"><button type="button" data-material="optical" aria-pressed="true">Optical</button><button type="button" data-material="sun" aria-pressed="false">Sun</button></div>
          <div class="lens-inspection"><button type="button" data-turn="-1" aria-label="Rotate glasses left">←</button><button type="button" data-reset>Reset view</button><button type="button" data-turn="1" aria-label="Rotate glasses right">→</button></div>
          <p>Drag to inspect · scroll to explore</p>
        </div>
        <div class="lens-stage-foot"><nav class="lens-perspective-index" aria-label="Four design perspectives"><a href="#projects"><span>01</span> Clarity</a><a href="#continuity"><span>02</span> Continuity</a><a href="#connection"><span>03</span> Connection</a><a href="#judgment"><span>04</span> Judgment</a></nav><button class="lens-motion" type="button" data-motion aria-pressed="false" hidden>Reduce motion</button><span class="lens-scroll-note">Scroll through the lens <span aria-hidden="true">↓</span></span></div>
        <p class="lens-status" role="status" data-scene-status>Static perspective. All projects are available below.</p>
      </div>
    </section>
    <section class="lens-project lens-clarity" id="projects" aria-labelledby="d2l-lens-title" tabindex="-1">
      <div class="lens-entry-slot"><div class="lens-project-entry d2l-world" data-entry>
        <div class="d2l-world-guides" aria-hidden="true"><i></i><i></i><i></i></div>
        <header class="d2l-world-title"><p class="lens-label">D2L Redesign / 01 — The question</p><h2 id="d2l-lens-title">Which file<br/>will <em>count?</em></h2><p>One question before Submit.</p></header>
        <figure class="lens-d2l-primary d2l-selected"><div class="d2l-artifact-edge"><span class="lens-label">02 / The selected-file decision</span><span aria-hidden="true">Review → Submit</span></div><div class="d2l-selected-viewport"><img src={d2l.file.image.src} width={d2l.file.image.width} height={d2l.file.image.height} alt={d2l.file.alt} decoding="async"/></div><figcaption>Original team artifact · Figma 554:1377<span class="d2l-mobile-caption"> · Dialog excerpt on narrow screens</span> <a href={d2l.file.image.src}>Open full-size artifact ↗</a></figcaption></figure>
        <p class="d2l-selection-note">Keep the chosen filename visible.<br/>Make changing the choice possible.</p>
      </div></div>
      <div class="d2l-decision-strip"><span class="lens-label">The problem / the proposal</span><p>Reviewing a file and recording a submission answer different questions. The proposal gives each its own state.</p></div>
      <section class="d2l-record-scene" aria-labelledby="d2l-record-heading"><div class="d2l-record-copy"><p class="lens-label">03 / The submission record</p><h3 id="d2l-record-heading">A choice reviewed.<br/><em>A record retained.</em></h3><p>The submitted-status label, filename and illustrative date belong to the record—not the file-review decision.</p></div><figure class="d2l-record-artifact"><div class="d2l-record-viewport"><img src={d2l.history.image.src} width={d2l.history.image.width} height={d2l.history.image.height} alt="Excerpt of the original D2L submission-history concept showing Submitted status, filename and an illustrative date" loading="lazy" decoding="async"/></div><figcaption>Submission-record excerpt · Original team artifact / Figma 554:1169 · Illustrative data <a href={d2l.history.image.src}>Open full-size submission record ↗</a></figcaption></figure></section>
      <div class="d2l-shared-work"><div><p class="lens-label">04 / My shared contribution</p><p>Heuristic evaluation, task mapping, interface exploration and prototyping with the academic project team.</p><p class="lens-small">These are proposed interface states. Usability improvements remain unvalidated.</p></div><div class="lens-actions"><a class="lens-link" href="/work/d2l-redesign/">Read the D2L case study ↗</a><a class="lens-link" href="https://www.figma.com/proto/piRHnDp4bwoVkKMo1mHSt7/Team--1?page-id=554%3A550&amp;node-id=554-1219&amp;scaling=scale-down&amp;content-scaling=fixed" target="_blank" rel="noopener noreferrer">Open D2L prototype <span class="lens-new-tab">(new tab)</span> ↗</a></div></div>
    </section>
    <section class="d2l-exit" id="between-perspectives" aria-labelledby="d2l-exit-title"><div class="d2l-exit-stage"><canvas data-exit-canvas aria-hidden="true"></canvas><div class="d2l-exit-copy"><p class="lens-label">Back to the lens / A different question next</p><h2 id="d2l-exit-title">Clarity, before<br/><em>commitment.</em></h2><a class="lens-link" href="#continuity">Next perspective: Continuity <span aria-hidden="true">↓</span></a><p class="lens-small">Apple Ring / Independent concept preview</p></div><p class="d2l-exit-note lens-label">01 — Clarity / 02 — Continuity</p></div></section>
    <section class="lens-storyboard" aria-labelledby="other-perspectives">
      <div class="lens-board-heading"><p class="lens-label">Next perspectives / visual directions</p><h2 id="other-perspectives">The work changes.<br/><em>The intention stays.</em></h2><p>The following chapters remain static previews while the D2L environment is under review. Their case studies and prototypes are available directly.</p></div>
      <article class="lens-preview lens-continuity" id="continuity" aria-labelledby="ring-perspective"><header class="lens-preview-copy"><span class="lens-label">02 / CONTINUITY</span><h3 id="ring-perspective">Apple Ring</h3><p class="lens-preview-question">Why a ring, if you<br/>already have Watch?</p><p>Let Watch charge.<br/>Keep the overnight story connected.</p><p class="lens-small">A proposed handoff, not real device integration. Independent speculative concept; not affiliated with Apple.</p></header><div class="lens-ring-evidence"><figure class="lens-ring-product"><img src={ring.product.image.src} width={ring.product.image.width} height={ring.product.image.height} alt={ring.product.alt} loading="lazy" decoding="async"/><figcaption>Proposed hardware · AI-generated visualization</figcaption></figure><figure class="lens-ring-handoff"><div class="lens-handoff-caption"><span class="lens-label">Make the source visible</span><h4>A handoff.<br/><em>Not a missing night.</em></h4><p>The proposed companion names Ring as the source and shows when it last synced. In the working web prototype, missing information stays missing.</p></div><div class="lens-watch-crop"><img src={ring.handoff.image.src} width={ring.handoff.image.width} height={ring.handoff.image.height} alt="Watch companion excerpt from the coded prototype showing a sample Ring sleep estimate, Ring battery and last-sync labels" loading="lazy" decoding="async"/></div><figcaption>Watch companion excerpt · Original coded web prototype capture · Sample readings <a href={ring.handoff.image.src}>View full-size handoff ↗</a></figcaption></figure></div><div class="lens-project-closing"><p class="lens-small">Concept direction, iterative critique and experience refinement with AI-assisted implementation.</p><div class="lens-actions"><a class="lens-link" href="/work/apple-ring/">Read the Apple Ring case study ↗</a><a class="lens-link" href="/prototypes/apple-ring/index.html">Try the Ring prototype ↗</a></div></div></article>
      <article class="lens-preview lens-connection" id="connection" aria-labelledby="community-perspective"><header class="lens-preview-copy"><span class="lens-label">03 / CONNECTION</span><h3 id="community-perspective">Community Spaces</h3><p class="lens-preview-question">A place to gather.<br/><em>A way to join.</em></p><p>A spatial proposal creates the setting. Event discovery gives participation a digital starting point.</p></header><div class="lens-community-pair"><figure class="lens-community-space"><span class="lens-label">The proposed place</span><div class="lens-spatial-crop"><img src={community.space.image.src} width={community.space.image.width} height={community.space.image.height} alt="Suleyman’s spatial sketch excerpt showing proposed study seating, paths and trees; cropped from the original team presentation" loading="lazy" decoding="async"/></div><figcaption>Suleyman’s original spatial sketch · Presentation excerpt <a href={community.space.image.src}>View complete team artifact ↗</a></figcaption></figure><figure class="lens-community-events"><span class="lens-label">The path to participation</span><img src={community.events.image.src} width={community.events.image.width} height={community.events.image.height} alt={community.events.alt} loading="lazy" decoding="async"/><figcaption>Original KIBS event-discovery interface · Illustrative events <a href={community.events.image.src}>View full-size interface ↗</a></figcaption></figure></div><div class="lens-project-closing"><p class="lens-small">Collaborative academic work: shared research, concept development, interaction design and presentation. The space is proposed; service assumptions and availability are unvalidated.</p><div class="lens-actions"><a class="lens-link" href="/work/community-spaces/">Read the Community Spaces case study ↗</a><a class="lens-link" href="https://www.figma.com/proto/pWjqzjZD2HgayCk6pQg3Zk/Wireframes?page-id=154%3A64&amp;node-id=214-348&amp;starting-point-node-id=214%3A348&amp;scaling=scale-down&amp;content-scaling=fixed" target="_blank" rel="noopener noreferrer">Open Community prototype <span class="lens-new-tab">(new tab)</span> ↗</a></div></div></article>
      <article class="lens-preview lens-judgment" id="judgment" aria-labelledby="align-perspective"><header class="lens-preview-copy"><span class="lens-label">04 / JUDGMENT</span><h3 id="align-perspective">ALIGN</h3><p class="lens-preview-question">A match is a claim.<br/><em>Show the evidence.</em></p><p>Distinguish what aligns, what differs and what remains unknown before reviewing an application.</p></header><div class="lens-align-evidence"><figure class="lens-align-summary"><span class="lens-label">The decision, made inspectable</span><img src={alignSummary.src} width={alignSummary.width} height={alignSummary.height} alt="Original M05 ALIGN summary exploration distinguishing preferences, self-declared evidence and unknown information" loading="lazy" decoding="async"/><figcaption>M05 summary exploration · Historical, not the current R05 demo. <a href={alignSummary.src}>View original summary ↗</a></figcaption></figure><figure class="lens-align-discovery"><span class="lens-label">Across screen sizes</span><img src={align.src} width={align.width} height={align.height} alt="Historical ALIGN M06 discovery artifact showing the responsive candidate experience and Decision Brief" loading="lazy" decoding="async"/><figcaption>Original M06 discovery artifact · Linked candidate demo uses R05 <a href={align.src}>View full-size discovery artifact ↗</a></figcaption></figure></div><div class="lens-align-principles" aria-label="Decision Brief principles"><p><span>01 / Conditions</span>Listing facts stay separate from your preferences.</p><p><span>02 / Evidence</span>Self-declared experience is not verified evidence.</p><p><span>03 / Unknowns</span>Missing information is shown as missing.</p></div><div class="lens-project-closing"><p class="lens-small">Product direction and iterative feedback; AI-assisted design exploration, documentation and implementation. Fictional data. No market validation or real application delivery.</p><div class="lens-actions"><a class="lens-link" href="/work/align/">Read the ALIGN case study ↗</a><a class="lens-link" href="/prototypes/align/">Try the ALIGN prototype ↗</a></div></div></article>
    </section>
    <section class="lens-person" id="person" aria-labelledby="person-title"><div class="lens-person-sticky"><div class="lens-return-object" aria-hidden="true"><canvas data-return-canvas></canvas><svg viewBox="0 0 600 200" class="lens-return-fallback"><g fill="none" stroke="#b9b3a4" stroke-width="2"><rect x="40" y="30" width="220" height="140" rx="55"/><rect x="340" y="30" width="220" height="140" rx="55"/><path d="M260 60Q300 35 340 60"/></g></svg></div><div class="lens-person-grid"><figure class="lens-portrait"><Image src={portrait} alt="Suleyman Koncagul wearing glasses and a dark shirt" widths={[400,700,1000]} sizes="(max-width: 700px) 88vw, 38vw" format="webp" loading="lazy"/><figcaption>Suleyman Koncagul / The person behind the perspective</figcaption></figure><div class="lens-person-copy"><p class="lens-label">The person behind the lens</p><h2 id="person-title">Now you know<br/>how I <em>see things.</em></h2><p>Let’s build something thoughtful together.</p><nav class="lens-contact" aria-label="Contact Suleyman"><a href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a><a href={site.linkedIn!}>LinkedIn <span aria-hidden="true">↗</span></a><a href={site.resumeHref!}>Resume (PDF) <span aria-hidden="true">↓</span></a></nav></div></div></div></section>
  </main>
  <footer class="lens-footer"><span>Through My Lens / Local experiment</span><a href="/">Return to the editorial portfolio ↗</a><a href="#intro">Back to the beginning ↑</a></footer>
</div>
<script>import '../../experiments/through-my-lens/lens';</script>
</BaseLayout>
