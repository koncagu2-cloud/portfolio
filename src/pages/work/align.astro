import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseOverview from '../../components/case-study/CaseOverview.astro';
import DecisionIndex from '../../components/case-study/DecisionIndex.astro';
import NextProject from '../../components/case-study/NextProject.astro';
import discovery from '../../assets/align/discovery.png';
import search from '../../assets/align/search.png';
import summary from '../../assets/align/summary.png';
import ledger from '../../assets/align/ledger.png';
import comparison from '../../assets/align/comparison.png';
import receipt from '../../assets/align/receipt.png';
