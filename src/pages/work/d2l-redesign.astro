---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseOverview from '../../components/case-study/CaseOverview.astro';
import DecisionIndex from '../../components/case-study/DecisionIndex.astro';
import NextProject from '../../components/case-study/NextProject.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import StudentJourney from '../../components/d2l/StudentJourney.astro';
import { d2lAssets as assets } from '../../data/d2l-assets';
import '../../styles/case-study.css';
import '../../styles/case-editorial.css';
import '../../styles/d2l.css';
const project = await getEntry('projects', 'd2l');
if (!project?.data.caseStudy || project.data.publicationStatus !== 'review') throw new Error('D2L review content is required.');
const cs = project.data.caseStudy;
const root = import.meta.env.BASE_URL;
const source = (node: string) => `https://www.figma.com/design/piRHnDp4bwoVkKMo1mHSt7/Team--1?node-id=${node.replace(':', '-')}`;
const findings = [
  { id: 'finding-location', title: 'Where am I in this course?', issue: 'The evaluator noted that the main navigation did not indicate the current page.', response: 'The assignment concept identifies the current area and names the assignment.', limitation: 'Orientation and consistency across courses still need evaluation.', node: '16:2', target: 'journey-requirements', link: 'Inspect the assignment context', artifact: assets.assignment },
  { id: 'finding-file', title: 'Which file will count?', issue: 'The evaluator described ambiguity around replacing an already-submitted file.', response: 'The proposal makes the chosen file visible before submission—a partial response.', limitation: 'Post-submission replacement remains an open design question.', node: '18:2', target: 'journey-file', link: 'Inspect selected-file review', artifact: assets.file },
  { id: 'finding-rubric', title: 'What belongs in this rubric cell?', issue: 'The evaluator described repeatedly checking which rubric cell should receive an entry.', response: 'The rubric maker separates and labels criteria, headers, and scores.', limitation: 'Easier or more accurate rubric authoring has not been demonstrated.', node: '9:6', target: 'instructor', link: 'Inspect the instructor concept', artifact: assets.rubric },
];
---
<BaseLayout title="D2L Redesign — Collaborative UX case study" description="An MSU collaborative academic redesign with a guided portfolio walkthrough of original student interface states and supporting instructor concepts. Review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study case-editorial d2l-case" tabindex="-1">
      <section id="challenge" class="case-intro" aria-label="Project overview and context">
        <div class="editorial-opening d2l-opening">
          <header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">Academic team project · Michigan State University</p><h1>{project.data.title}</h1><p class="case-deck">Which file will count?</p><p class="case-scope">A submission concept that keeps assignment requirements, the chosen file, and the submission record distinct.</p><p class="case-role"><span class="micro">My contribution · Shared team work</span>Heuristic evaluation, task mapping, interface exploration, and prototyping.</p><p class="opening-boundary">Academic proposal; usability improvements remain unvalidated.</p></header>
          <div class="opening-artifact"><ArtifactFigure asset={assets.file} eager /></div>
          <div class="opening-actions"><a class="text-link case-entry" href="#experience">Explore the student walkthrough <span aria-hidden="true">↓</span></a><a class="text-link" href="https://www.figma.com/proto/piRHnDp4bwoVkKMo1mHSt7/Team--1?page-id=554%3A550&amp;node-id=554-1219&amp;scaling=scale-down&amp;content-scaling=fixed" target="_blank" rel="noopener noreferrer" aria-label="Open D2L prototype in Figma (opens in a new tab)">Original Figma prototype <span aria-hidden="true">↗</span></a></div>
        </div>
        <CaseOverview items={[
          { label: 'Intended users', value: 'Students submitting coursework and instructors preparing assignments.' },
          { label: 'Team', value: 'Four-person collaborative team' },
          { label: 'Context', value: cs.context },
          { label: 'Deliverables', value: 'Student interface states, instructor setup, and rubric concepts.' },
        ]} />
        <p class="d2l-status"><strong>Scope.</strong> Collaborative academic concept; not an official D2L release or launched product. Usability validation and measured improvements are not established. This portfolio walkthrough presents original screens in task order; it does not establish a fully connected prototype. Screen content is illustrative.</p>
      </section>
      <DecisionIndex items={[
        { title: 'Keep assignment context visible', explanation: 'Missing location cues prompted a named assignment and active navigation. Consistency across courses still needs evaluation.', target: 'evaluation' },
        { title: 'Review the file before Submit', explanation: 'The selected filename and removal control make the pre-submit choice inspectable. Replacement after submission remains unresolved.', target: 'journey-file' },
        { title: 'Separate criteria from scores', explanation: 'Distinct rubric headers respond to ambiguity between cells. Easier authoring is an intended benefit, not a measured result.', target: 'instructor' },
      ]} />
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{cs.sections.map(section => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}</ul></nav>
      {cs.sections.filter(section => !['challenge', 'sources'].includes(section.id)).map(section => <ProcessSection {...section}>
        {section.id === 'evaluation' && <div class="d2l-findings">{findings.map(finding => <article id={finding.id}><h3>{finding.title}</h3><ArtifactFigure asset={finding.artifact} context={finding.title} /><p><strong>Observation.</strong> {finding.issue}</p><p class="d2l-response"><strong>Proposed response.</strong> {finding.response}</p><p class="d2l-response"><strong>Open question.</strong> {finding.limitation}</p><a class="finding-target" href={`#${finding.target}`}>{finding.link} →</a><p class="source-note"><a href={source(finding.node)}>Original evaluation · {finding.node}</a></p></article>)}</div>}
        {section.id === 'experience' && <>
          <StudentJourney />
          <details id="workflows" class="d2l-supporting-flow"><summary>Original student task flow</summary><p class="d2l-transcript">Select a course → Assignments → open an assignment → add or drag a file → review → confirm or go back → Submit → confirmation. The original diagram also includes a quiz branch.</p><ArtifactFigure asset={assets.studentFlow} /><ArtifactFigure asset={assets.home} /></details>
        </>}
        {section.id === 'instructor' && <>
          <div class="workflow-relationship"><p class="micro">How the work relates</p><ol><li><strong>Instructor setup</strong><span>Define requirements and criteria.</span></li><li><strong>Student interpretation</strong><span>Understand the assignment.</span></li><li><strong>Submission</strong><span>Review the chosen file.</span></li><li><strong>Evaluation</strong><span>Consider the work against criteria.</span></li></ol><p class="source-note">Relationship between the proposed workflows—not a verified connected prototype.</p></div>
          <div class="d2l-instructor"><div><h3>Separate criteria from scores.</h3><p>The rubric maker labels Criteria, Criteria Headers, and Score. That organization is a visible response to the evaluator’s concern about distinguishing cells.</p><details><summary>What to notice in the rubric</summary><ol><li>Explicit labels distinguish criteria from scoring.</li><li>Templates and draft controls appear alongside setup.</li></ol><p>These are interface proposals, not demonstrated improvements in grading.</p></details><p class="source-note"><a href={source('274:488')}>Original grading and submission settings</a> · <a href="#finding-rubric">Return to the rubric finding</a></p></div><ArtifactFigure asset={assets.rubric} /></div>
          <details class="d2l-supporting-flow"><summary>Original instructor task flow</summary><p class="d2l-transcript">Open the course → create an assignment → add details and criteria → attach supporting files → publish → grade → send feedback.</p><ArtifactFigure asset={assets.overview} /><ArtifactFigure asset={assets.instructorFlow} /></details>
        </>}
        {section.id === 'exploration' && <>
          <details class="d2l-supporting-flow"><summary>Inspect original student and instructor sketches</summary><div class="d2l-sketch-grid"><ArtifactFigure asset={assets.studentSketch} /><ArtifactFigure asset={assets.instructorSketch} /></div></details>
          <p class="comparison-reading"><strong>What changed.</strong> The assignment layout is retained; the final frame adds populated directions and comment formatting controls. This shows added interface detail, not evidence that the submission or navigation concerns were resolved.</p>
          <div class="d2l-iteration" role="group" aria-label="Earlier and final assignment prototype comparison"><div><h3>01 / Earlier assignment</h3><ArtifactFigure asset={assets.earlier} /></div><div><h3>02 / Final assignment</h3><ArtifactFigure asset={assets.assignment} /></div></div>
        </>}
        {section.id === 'reflection' && <div class="next-priorities d2l-reflection-priorities" role="group" aria-label="Prototype limitations and proposed next steps"><div><h3>Submission recovery</h3><p>The design shows removal before Submit; replacement after submission remains unresolved. Evaluate wrong-file recovery, unsupported files, and resubmission alongside instructor setup.</p></div><div><h3>Status consistency</h3><p>The confirmation overlay retains “Not Submitted” underneath. Reconcile the displayed states and evaluate whether people understand when their work is recorded. <a href={source('554:1452')}>Inspect the original confirmation state</a>.</p></div><div><h3>Complete the connections</h3><p>An assignment-list link is missing, and history sits on a separate path. Connect and evaluate the full journey, including keyboard access and screen-reader feedback.</p></div></div>}
      </ProcessSection>)}
      <section id="sources" class="case-sources" aria-labelledby="sources-heading"><p class="micro">07 / Resources</p><h2 id="sources-heading">Project Credits &amp; Resources</h2><p>D2L Redesign was developed collaboratively by Suleyman Koncagul, Gabe Bustillo, Benji Fajardo, and Alana Alexander as a Michigan State University team project. All four teammates worked together throughout the design process.</p><ul><li><a href={source('0:1')}>Original heuristic analysis and questions</a></li><li><a href={source('123:2')}>Original student and instructor task flows</a></li><li><a href={source('160:2')}>Original sketches, visual exploration, and style guide</a></li><li><a href={source('554:550')}>Final student high-fidelity prototype</a> · <a href={source('408:935')}>Earlier student prototype</a></li><li><a href={source('241:193')}>Original instructor designs</a></li></ul><p class="source-note">Original designs and colors are preserved. The style guide references Iconscout; embedded imagery, icons, institutional marks, and workbook references require attribution/rights review before public launch. Inspiration references are not presented as team-designed interfaces. Raw interview responses and grading records are not reproduced. Course and term remain unconfirmed.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
      <NextProject next={{ slug: 'community-spaces', title: 'Community Spaces', description: 'Connecting a proposed shared space with event discovery and registration.' }} />
    </main><SiteFooter />
  </div>
</BaseLayout>
