---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CaseOverview from '../../components/case-study/CaseOverview.astro';
import DecisionIndex from '../../components/case-study/DecisionIndex.astro';
import NextProject from '../../components/case-study/NextProject.astro';
import ProcessSection from '../../components/case-study/ProcessSection.astro';
import ArtifactFigure from '../../components/case-study/ArtifactFigure.astro';
import DesignComparison from '../../components/case-study/DesignComparison.astro';
import { appleRingAssets as assets } from '../../data/apple-ring-assets';
import '../../styles/case-study.css';
import '../../styles/case-editorial.css';
import '../../styles/apple-ring.css';
const project = await getEntry('projects', 'apple-ring');
if (!project?.data.caseStudy) throw new Error('Apple Ring case study content is required.');
const cs = project.data.caseStudy;
const root = import.meta.env.BASE_URL;
const sectionOrder = ['handoff', 'question', 'states', 'charging', 'continuity', 'implementation', 'validation'];
const readingSections = sectionOrder.map((id, index) => {
  const section = cs.sections.find(section => section.id === id)!;
  const paragraphs = id === 'implementation' ? [
    'The result is a responsive product story with finish selection, shared display preferences, and a working handoff demonstration. I directed the concept and revisions; Codex assisted with strategy, writing, implementation, and checks. Product stills are AI-generated.',
  ] : id === 'validation' ? [
    'The web implementation makes the hypothesis inspectable; it does not establish demand. Recorded checks below are implementation QA, not participant research or proof of hardware feasibility.',
    'A usability protocol is prepared. The next step is to ask Watch owners to explain the partnership and explore missing and disconnected states. If the concept offers too little beyond wearing Watch overnight, the product direction should change.',
  ] : id === 'continuity' ? [
    'Closing and reopening the viewer discarded a chosen finish. The revision connects the viewer and page through shared in-memory preferences for this visit.',
    'Reset restores the sample examples while preserving display preferences. These are demonstration settings, not device permissions; no personal readings are stored or transmitted.',
  ] : section.paragraphs;
  return { ...section, paragraphs, kicker: `${String(index + 1).padStart(2, '0')} / ${section.kicker.split(' / ')[1]}` };
});
---
<BaseLayout title="Apple Ring — Independent product & web experience case study" description="An independent, AI-assisted Apple Ring concept by Suleyman Koncagul. Product storytelling, a proposed Ring–Watch handoff, and a coded web prototype; review only.">
  <div id="top"><SiteHeader />
    <main id="main" class="container case-study case-editorial ring-case" tabindex="-1">
      <div class="ring-intro editorial-opening"><header class="case-hero"><a class="case-back" href={`${root}#work`}>← Back to selected work</a><p class="micro">Independent concept · AI-assisted</p><h1>{project.data.title}</h1><p class="case-deck">What happens when your watch comes off?</p><p class="case-scope">An overnight record while Watch charges, ready to review in the morning. A product hypothesis explored through a coded web prototype.</p><p class="case-role"><span class="micro">My contribution</span>{cs.role}</p><p class="opening-boundary">Not affiliated with Apple. Proposed hardware and integrations; illustrative readings.</p></header><div class="opening-artifact"><ArtifactFigure asset={assets.product} eager /></div><div class="ring-demo-actions opening-actions"><a class="ring-demo-link" href={`${root}prototypes/apple-ring/index.html`}>Explore the scrolling prototype <span aria-hidden="true">↗</span></a><a class="text-link" href="#handoff">See the handoff decision <span aria-hidden="true">↓</span></a></div></div>
      <CaseOverview items={[
        { label: 'Intended users', value: 'Hypothesis: Watch owners who sometimes remove it overnight.' },
        { label: 'Context', value: cs.context },
        { label: 'Deliverable', value: 'Responsive product story and working web prototype.' },
        { label: 'Status', value: 'Independent concept; participant and hardware validation pending.' },
      ]} />

      <DecisionIndex items={[
        { title: 'Make the partnership concrete', explanation: 'Replace an ecosystem label with an overnight-to-morning handoff. Its value to Watch owners remains a hypothesis.', target: 'handoff' },
        { title: 'Withhold unavailable readings', explanation: 'An incomplete night and a disconnected Ring show different states. Neither substitutes a plausible number for missing information.', target: 'states' },
        { title: 'Keep choices across return paths', explanation: 'A discarded finish exposed a state defect. Shared in-memory preferences now connect the viewer and page for this visit.', target: 'continuity' },
      ]} />
      <nav class="case-toc" aria-label="Case study sections"><p class="micro">In this case study</p><ul>{readingSections.map(section => <li><a href={`#${section.id}`}>{section.kicker.replace(/^\d+ \/ /, '')}</a></li>)}<li><a href="#sources">Credits & resources</a></li></ul></nav>
      {readingSections.map(section => <ProcessSection {...section}>
        {section.id === 'question' && <div class="ring-roles"><div><h3>Ring collects quietly.</h3><p>Proposed pulse and movement information, including sleep estimates.</p></div><div><h3>Watch makes it accessible.</h3><p>Workouts, on-wrist interaction, and a proposed view of Ring information.</p></div><div><h3>iPhone brings it together.</h3><p>Proposed sync, setup, information choices, and detailed review.</p></div></div>}
        {section.id === 'handoff' && <><div class="state-reading-key" aria-label="Reading the handoff"><p><strong>Source</strong> Ring supplies the sample estimate.</p><p><strong>Sync</strong> Last-sync time is shown via iPhone.</p><p><strong>Unavailable data</strong> Missing and disconnected states withhold readings.</p></div><ArtifactFigure asset={assets.handoff} /><div class="prototype-task"><h3>Try the handoff.</h3><p>Switch from overnight to morning, then try missing readings or a disconnected Ring. Compare the source, sync, and reading shown in each state.</p><a class="text-link" href={`${root}prototypes/apple-ring/index.html#continuity`}>Explore the handoff interaction <span aria-hidden="true">↗</span></a></div></>}
        {section.id === 'states' && <div class="ring-states"><ArtifactFigure asset={assets.missing} screen /><ArtifactFigure asset={assets.disconnected} screen /></div>}
        {section.id === 'charging' && <DesignComparison before={assets.before} after={assets.after} beforeLabel="Earlier / Unresolved geometry" afterLabel="Revised / Supported placement" label="Earlier and revised charging concept comparison" screen={false} />}
        {section.id === 'continuity' && <ArtifactFigure asset={assets.viewer} />}
        {section.id === 'implementation' && <div class="ring-build-note"><h3>Implementation boundaries</h3><p>The bundled prototype runs in the browser. No native Watch app, real device connection, or Apple Health integration is implemented.</p><details><summary>Front-end structure and access</summary><p>HTML, CSS, and JavaScript support the product story and shared state. The procedural Three.js viewer loads on demand, with a static fallback.</p><p>Explicit controls accompany dragging; the prototype also includes visible focus, reduced-motion alternatives, and mobile result visibility.</p></details></div>}
        {section.id === 'validation' && <div class="ring-evidence"><h3>Evidence and limits</h3><dl><div><dt>Responsive handoff</dt><dd>40 sampled layout combinations. No representative real-device study.</dd></div><div><dt>Shared journeys</dt><dd>Scripted state and return-path checks. No participant task-success results.</dd></div><div><dt>Accessibility</dt><dd>Keyboard checks and four sampled automated accessibility states. No full conformance claim.</dd></div><div><dt>Product feasibility</dt><dd>Geometry review and provisional targets. No physical prototype or measured runtime.</dd></div></dl><a class="text-link" href={`${root}evidence/apple-ring-validation.json`}>Read the prototype QA summary <span aria-hidden="true">↗</span></a></div>}
      </ProcessSection>)}
      <section id="sources" class="case-sources" aria-labelledby="sources-heading"><p class="micro">Source notes / Credits</p><h2 id="sources-heading">Project credits & resources</h2><p>Suleyman Koncagul supplied the concept and directed its iterative critique. Codex assisted with strategy, writing, implementation, browser checks, and deployment. AI-generated product stills and captures of the actual coded prototype are labeled throughout.</p><ul><li>Owner-retained Apple Ring prototype source, decision notes, and prepared portfolio case study, October 2026.</li><li>Earlier and revised charging proposals, shared-state revisions, and sampled implementation checks; evidence provenance is retained with this repository.</li><li><a href="https://www.apple.com/macbook-pro/">Apple MacBook Pro presentation reference</a> — a visual reference, not a project affiliation.</li></ul><p class="source-note">Apple and its trademarks belong to Apple Inc. No participant research findings, commercial impact, medical accuracy, or tested battery life are claimed. The five-day figure in the product concept is a provisional target. The bundled demo is part of this review build; the separate hosted copy's access settings are unchanged.</p><a class="text-link" href={`${root}#work`}>Back to selected work <span aria-hidden="true">↗</span></a></section>
      <NextProject previous={{ slug: 'community-spaces', title: 'Community Spaces', description: 'A shared-space proposal connected to event discovery and registration.' }} next={{ slug: 'align', title: 'ALIGN', description: 'A job-discovery concept connecting listing facts, candidate preferences, and unknowns.' }} />
    </main><SiteFooter />
  </div>
</BaseLayout>
