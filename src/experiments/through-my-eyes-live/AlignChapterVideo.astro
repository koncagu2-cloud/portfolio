---
const recording='/experiments/through-my-eyes-live/videos/align-prototype.mp4';
const poster='/experiments/through-my-eyes-live/previews/align-current-product.png';
---
<figure class="tme-align-recording" data-video-player data-chapter-video="chapter-align">
 <div class="tme-chapter-video-image">
  <img src={poster} width="1100" height="780" alt="Current ALIGN coded job-discovery interface with fictional listings and candidate data" loading="lazy" decoding="async"/>
  <video hidden loop playsinline muted preload="none" data-auto-preview data-video-src={recording} data-project-name="ALIGN chapter" poster={poster} id="align-chapter-recording" aria-label="ALIGN coded prototype recording" aria-describedby="align-chapter-recording-description" />
 </div>
 <div class="tme-video-toolbar"><button type="button" data-video-play aria-controls="align-chapter-recording" aria-pressed="false">Play prototype preview</button><span>0:12 · Silent</span><a href={recording} target="_blank" rel="noopener noreferrer">View larger recording ↗<span class="sr-only"> (new tab)</span></a></div>
 <figcaption>Working coded prototype · Fictional listings
  <details class="tme-video-description"><summary>Recording description</summary><p id="align-chapter-recording-description">The ALIGN prototype moves from Discover to Search, previews different fictional roles and their evidence, then opens full role details. Candidate preferences and listings are examples; no application is sent.</p></details>
  <p class="tme-video-status" data-video-status role="status" aria-live="polite"></p>
  <a href="/prototypes/align/demo/index.html?preview=1" data-reader="prototype" data-title="ALIGN — Fictional, memory-only candidate prototype">Try the coded candidate journey ↗</a>
 </figcaption>
</figure>
<style is:global>
.tme .tme-align-recording .tme-chapter-video-image{position:relative;aspect-ratio:16/9;background:#dfe7db}
.tme .tme-align-opening>.tme-align-recording .tme-chapter-video-image>img{display:block;width:100%;height:100%;max-height:none;object-fit:contain}
.tme .tme-align-recording .tme-chapter-video-image>video{background:#dfe7db}
.tme .tme-align-recording :is(.tme-video-toolbar button,.tme-video-toolbar a,.tme-video-toolbar>span,.tme-video-description,.tme-video-status){color:#d0e0d5}
.tme .tme-align-recording .tme-video-toolbar :is(button,a){border-color:#8fa898}
.tme .tme-align-recording .tme-video-description p{font-size:1rem;line-height:1.65}
.tme .tme-align-recording figcaption{margin-top:12px}
@media(max-width:700px){
 .tme[data-cinematic=true] .tme-align-opening>div{grid-column:1;grid-row:1;min-width:0}
 .tme[data-cinematic=true] .tme-align-opening>.tme-align-recording{grid-column:1;grid-row:2;width:100%;min-width:0}
}
</style>
