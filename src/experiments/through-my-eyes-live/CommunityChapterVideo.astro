---
import {communityAssets as community} from '../../data/community-spaces-assets';
const recording='/experiments/through-my-eyes-live/videos/community-original-figma.mp4';
---
<figure class="tme-state-viewer tme-community-recording" data-video-player data-chapter-video="chapter-community">
 <p class="tme-eyebrow">Original Figma prototype</p>
 <div class="tme-chapter-video-image">
  <img src={community.events.image.src} width={community.events.image.width} height={community.events.image.height} alt={community.events.alt} loading="lazy" decoding="async"/>
  <video hidden loop playsinline muted preload="none" data-auto-preview data-video-src={recording} data-project-name="Community Spaces chapter" poster={community.events.image.src} id="community-chapter-recording" aria-label="Community Spaces original Figma prototype recording" aria-describedby="community-chapter-recording-description" />
 </div>
 <div class="tme-video-toolbar"><button type="button" data-video-play aria-controls="community-chapter-recording" aria-pressed="false">Play prototype preview</button><span>0:09 · Silent</span><a href={recording} target="_blank" rel="noopener noreferrer">View larger recording ↗<span class="sr-only"> (new tab)</span></a></div>
 <figcaption>Original team Figma prototype · Recorded walkthrough
  <details class="tme-video-description"><summary>Recording description</summary><p id="community-chapter-recording-description">Home → Events → event details → registration check → confirmation → Home. This is a recording of the original team Figma prototype, not a live service. No real registration or booking occurs.</p></details>
  <p class="tme-video-status" data-video-status role="status" aria-live="polite"></p>
  <a class="tme-chapter-link" href="#community-experience">Explore original event screens ↗</a>
 </figcaption>
</figure>
<style is:global>
.tme .tme-community-recording{margin:0}
.tme .tme-community-recording .tme-chapter-video-image{background:#f1ebf3;width:min(100%,250px);margin-inline:auto}
.tme .tme-community-recording .tme-chapter-video-image>img{display:block;width:100%;height:auto}
.tme .tme-community-recording .tme-chapter-video-image>video{background:#f1ebf3}
.tme .tme-community-recording :is(figcaption,.tme-video-toolbar button,.tme-video-toolbar a,.tme-video-toolbar>span,.tme-video-description,.tme-video-status,.tme-chapter-link){color:#44324f}
.tme .tme-community-recording .tme-video-toolbar :is(button,a){border-color:#8d759d}
.tme .tme-community-recording .tme-video-description p{font-size:1rem;line-height:1.65}
.tme .tme-community-recording figcaption{margin-top:12px}
.tme .tme-community-recording .tme-chapter-link{display:inline-flex;align-items:center;min-height:44px;margin-top:8px}
</style>

<style is:global>
/* Present the recorded phone itself, rather than a pale presentation board. */
.tme[data-cinematic=true] #chapter-community .tme-community-story{grid-template-rows:auto;align-items:center}
.tme[data-cinematic=true] #chapter-community .tme-community-story>.tme-community-opening{align-self:center}
.tme[data-cinematic=true] .tme-community-story>.tme-state-viewer.tme-community-recording{grid-row:1;background:transparent;border:0;padding:0;justify-self:center}
.tme .tme-community-recording>.tme-eyebrow{color:#cdbbdf!important;margin-bottom:18px;text-align:center}
.tme .tme-community-recording .tme-chapter-video-image{aspect-ratio:660/1348;overflow:hidden;border-radius:14% / 7%;background:#080808;box-shadow:0 20px 48px #100c1d55}
.tme .tme-community-recording .tme-chapter-video-image>img{width:100%;height:100%;object-fit:contain;background:#fff}
/* Crop only the recording's external black margin. Preserve the complete phone screen. */
.tme .tme-community-recording .tme-chapter-video-image>video{width:109.09091%;height:101.48368%;max-width:none;left:-4.54545%;top:-.74184%;object-fit:fill;background:#080808}
.tme .tme-community-recording :is(figcaption,.tme-video-toolbar button,.tme-video-toolbar a,.tme-video-toolbar>span,.tme-video-description,.tme-video-status,.tme-chapter-link){color:#dfd0e9}
.tme .tme-community-recording .tme-video-toolbar :is(button,a){border-color:#a68cba}
.tme[data-cinematic=true] .tme-community-story>.tme-state-viewer.tme-community-recording figcaption{color:#dfd0e9}
@media(max-width:700px){.tme[data-cinematic=true] .tme-community-story>.tme-state-viewer.tme-community-recording{grid-row:2}}
</style>
