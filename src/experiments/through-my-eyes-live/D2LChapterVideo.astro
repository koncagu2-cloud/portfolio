---
import {d2lAssets as d2l} from '../../data/d2l-assets';
const recording='/experiments/through-my-eyes-live/videos/d2l-prototype.mp4';
---
<figure class="tme-artifact tme-d2l-evidence" data-video-player data-chapter-video="d2l-world">
 <div class="tme-interface-label"><span>01 / Original team interface</span><span>Submission walkthrough</span></div>
 <div class="tme-chapter-video-image">
  <img data-reflection-image src={d2l.file.image.src} width={d2l.file.image.width} height={d2l.file.image.height} alt={d2l.file.alt} decoding="async"/>
  <video hidden loop playsinline muted preload="none" data-auto-preview data-video-src={recording} data-project-name="D2L chapter" poster={d2l.file.image.src} id="d2l-chapter-recording" aria-label="D2L original Figma prototype recording" aria-describedby="d2l-chapter-recording-description" />
 </div>
 <div class="tme-video-toolbar">
  <button type="button" data-video-play aria-controls="d2l-chapter-recording" aria-pressed="false">Play prototype preview</button>
  <span>0:13 · Silent</span>
  <a href={recording} target="_blank" rel="noopener noreferrer">View larger recording ↗<span class="sr-only"> (new tab)</span></a>
 </div>
 <figcaption>Original team Figma prototype · Recorded walkthrough <a href={d2l.file.image.src}>View original screen ↗</a>
  <details class="tme-video-description"><summary>Recording description</summary><p id="d2l-chapter-recording-description">The original Figma flow opens Add File, selects the project PDF, reviews the filename, submits, confirms, and opens submission history. This is a prototype: no real upload, submission or email occurs.</p></details>
  <p class="tme-video-status" data-video-status role="status" aria-live="polite"></p>
  <a href="#d2l-interaction" class="tme-d2l-try"><span>Try the submission sequence ↗</span><small>Review → Submit → Record · Interpretive demo</small></a>
 </figcaption>
</figure>
<style is:global>
.tme-chapter-video-image{position:relative;background:#cbd5c5}
.tme-chapter-video-image>img{display:block}
.tme-chapter-video-image>video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#cbd5c5}
.tme-chapter-video-image.tme-video-active>img{visibility:hidden}
.tme .tme-d2l-evidence :is(.tme-video-toolbar button,.tme-video-toolbar a,.tme-video-toolbar>span,.tme-video-description,.tme-video-status){color:#304c3a}
.tme .tme-d2l-evidence .tme-video-toolbar :is(button,a){border-color:#677d68}
.tme .tme-d2l-evidence .tme-video-description p{font-size:1rem;line-height:1.65}
</style>
