---
import ProjectHeroArt from './ProjectHeroArt.astro';
import {d2lAssets as d2l} from '../../data/d2l-assets';
import {appleRingAssets as ring} from '../../data/apple-ring-assets';
import {communityAssets as community} from '../../data/community-spaces-assets';
const currentAlign={src:'/experiments/through-my-eyes-live/previews/align-current-product.png',width:1100,height:780};
const recordings:Record<string,{file:string;duration:string;label:string;summary:string;url:string;external?:boolean}>= {
 'd2l-world':{file:'d2l-prototype.mp4',duration:'0:13',label:'Original team Figma prototype · Silent recording',summary:'The original Figma flow opens Add File, selects GD Work and the project PDF, reviews the filename, submits, confirms, and opens submission history. This is a prototype: no real upload, submission or email occurs.',url:'https://www.figma.com/proto/piRHnDp4bwoVkKMo1mHSt7/Team--1?page-id=554%3A550&node-id=554-1219&scaling=scale-down&content-scaling=fixed',external:true},
 'chapter-ring':{file:'ring-scroll-preview.mp4',duration:'0:14',label:'Independent coded concept · Website walkthrough',summary:'A quick continuous scroll through the existing Apple Ring concept website, from the product hero through design, finishes, Ring and Watch continuity, everyday use, interface exploration, accessibility, setup and charging to the footer. This is an independent speculative concept, not an official Apple product or real hardware integration.',url:'/prototypes/apple-ring/index.html#continuity'},
 'chapter-community':{file:'community-original-figma.mp4',duration:'0:09',label:'Original team Figma prototype · Silent recording',summary:'A recording of the original team Figma prototype being used: Home, Events, event details, the registration check and confirmation, then back to Home. Cropped to the prototype’s phone frame; browser and desktop controls are excluded. This is a design prototype: no real registration or booking occurs.',url:'https://www.figma.com/proto/pWjqzjZD2HgayCk6pQg3Zk/Wireframes?node-id=214-348&p=f&t=uG27ffbiek989eDh-1&scaling=scale-down&content-scaling=fixed&page-id=154%3A64&starting-point-node-id=214%3A348',external:true},
 'chapter-align':{file:'align-prototype.mp4',duration:'0:12',label:'Working coded prototype · Fictional listings',summary:'The ALIGN prototype moves from Discover to Search, previews different fictional roles and their evidence, then opens full role details. Candidate preferences and listings are examples; no application is sent.',url:'/prototypes/align/demo/index.html?preview=1'}
};
const autoplayPreviews=['d2l-world','chapter-ring','chapter-community','chapter-align'];
const projects=[
 {id:'d2l-world',name:'D2L',theme:'Clarity',image:d2l.file.image,alt:d2l.file.alt,text:'Which file will count?',context:'Collaborative academic redesign',contribution:'Shared heuristic evaluation, task mapping, interface exploration and prototyping.',case:'/work/d2l-redesign/'},
 {id:'chapter-ring',name:'Apple Ring',theme:'Possibility',image:ring.product.image,alt:ring.product.alt,text:'What happens when Watch comes off?',context:'Independent speculative concept',contribution:'Product direction, interaction design and AI-assisted prototype implementation.',case:'/work/apple-ring/'},
 {id:'chapter-community',name:'Community Spaces',theme:'Connection',image:community.details.image,alt:community.details.alt,text:'What do you need to know before joining?',context:'Collaborative academic concept',contribution:'Research, concept development, interaction design and presentation with the team.',case:'/work/community-spaces/'},
 {id:'chapter-align',name:'ALIGN',theme:'Judgment',image:currentAlign,alt:'Current ALIGN coded job-discovery interface with fictional listings and candidate data',text:'A match is a claim. Where is the evidence?',context:'Current coded prototype / Fictional data',contribution:'Product direction and iterative feedback; AI-assisted design and implementation.',case:'/work/align/'}
];
---
<aside class="tme-hero-perspectives" aria-labelledby="hero-perspectives-title" id="hero-projects">
 <header class="tme-scanner-heading"><div><p>Through My Eyes / Selected work</p><h2 id="hero-perspectives-title">Perspective Scanner</h2></div><button type="button" data-scanner-close aria-label="Close Perspective Scanner">Close ×</button></header>
 <nav aria-label="Available perspectives"><p class="tme-scanner-label">Available perspectives</p><ol>{projects.map((p,i)=><li><button type="button" data-hero-project={p.id} aria-pressed={i===0} aria-controls={`hero-preview-${p.id}`}><span class="tme-hp-number" aria-hidden="true">0{i+1}</span><strong>{p.name}</strong><small>{p.theme}</small><span class="tme-hp-arrow" aria-hidden="true">↗</span></button></li>)}</ol></nav>
 <div class="tme-hp-preview" aria-label="Selected project details">{projects.map((p,i)=><article id={`hero-preview-${p.id}`} data-hero-preview={p.id} data-video-player={recordings[p.id]?true:undefined} hidden={i!==0}>
 <div class="tme-scanner-project"><p class="tme-scanner-label">{`0${i+1} / ${p.theme}`}</p><h3>{p.name}</h3></div>
<p class="tme-scanner-challenge">{p.text}</p><p class="tme-scanner-context">{p.context}{p.id==='chapter-ring'&&' · Not affiliated with Apple'}</p><div class="tme-scanner-actions"><a href={`#${p.id}`} data-scan-enter>Explore Perspective <span aria-hidden="true">↗</span></a><a href={p.case} data-reader="case" data-title={`${p.name} — Case study`}>Read Case Study ↗</a></div>
 <ProjectHeroArt project={p.id}/><p class="tme-scanner-contribution"><strong>My contribution</strong>{p.contribution}</p><details class="tme-supporting-recording" data-recording><summary>Watch the prototype recording <span>{recordings[p.id].duration} · Silent</span></summary><figure><div class:list={['tme-scanner-image',{'tme-scanner-image-pair':p.id==='chapter-community'}]}>{p.id==='chapter-community' && <svg viewBox="1410 50 552 370" role="img" aria-label="Suleyman’s original physical-space sketch, cropped from the team presentation"><image href={community.space.image.src} width="1994" height="1054" /></svg>}<img src={p.image.src} width={p.image.width} height={p.image.height} alt={p.alt} decoding="async"/>{recordings[p.id]&&<video hidden controls={!autoplayPreviews.includes(p.id)} loop={autoplayPreviews.includes(p.id)} data-auto-preview={autoplayPreviews.includes(p.id)?true:undefined} playsinline muted preload="none" poster={p.image.src} id={`video-${p.id}`} data-preview-video data-video-src={`/experiments/through-my-eyes-live/videos/${recordings[p.id].file}`} data-project-name={p.name} aria-label={`${p.name} prototype recording`} aria-describedby={`recording-description-${p.id}`} />}</div><figcaption>{p.id==='chapter-community'?'Original spatial sketch + team event-details screen':p.context}</figcaption></figure>
 {recordings[p.id]&&<div class="tme-video-context">{(p.id==='chapter-ring'||p.id==='chapter-community'||p.id==='chapter-align')&&<progress class="tme-video-progress" data-video-progress value="0" max="1" aria-label={`${p.name} recording playback progress`}/>}<div class="tme-video-toolbar"><button type="button" data-video-play aria-controls={`video-${p.id}`} aria-pressed="false">Play prototype preview</button><span>{recordings[p.id].duration} · Silent</span><a href={`/experiments/through-my-eyes-live/videos/${recordings[p.id].file}`} target="_blank" rel="noopener noreferrer">View larger recording ↗<span class="sr-only"> (new tab)</span></a><a href={recordings[p.id].url} target={recordings[p.id].external?'_blank':undefined} rel={recordings[p.id].external?'noopener noreferrer':undefined} data-reader={recordings[p.id].external?undefined:'prototype'} data-title={`${p.name} — Interactive prototype`}>{recordings[p.id].external?'Try original Figma ↗':'Try coded prototype ↗'}{recordings[p.id].external&&<span class="sr-only"> (new tab)</span>}</a></div><p class="tme-video-label">{recordings[p.id].label}</p><details class="tme-video-description"><summary>Recording description</summary><p id={`recording-description-${p.id}`}>{recordings[p.id].summary}</p></details><p data-video-status class="tme-video-status" role="status"></p></div>}
 </details>

 <div class="tme-scanner-journey"><a href={`#${p.id}`} data-chapter-link class="tme-scanner-direct">Open chapter without motion ↗</a></div>
 </article>)}</div><p class="tme-scanner-status" role="status" data-scanner-status></p>
</aside>
