---
import {appleRingAssets as ring} from '../../data/apple-ring-assets';
import {communityAssets as community} from '../../data/community-spaces-assets';
import d2l from '../../assets/d2l/file-review.webp';
import summary from '../../assets/align/summary.png';
import comparison from '../../assets/align/comparison.png';
import discovery from '../../assets/align/discovery.png';
import './chapters.css';
import CommunityChapterVideo from './CommunityChapterVideo.astro';
import AlignChapterVideo from './AlignChapterVideo.astro';
import RingChapterVideo from './RingChapterVideo.astro';
import {site} from '../../data/site';
import ClosingBio from './ClosingBio.astro';
const {selectionOnly = false} = Astro.props;
const projects=[{n:'01',title:'D2L',theme:'Clarity',target:'d2l-world',case:'/work/d2l-redesign/',text:'Make the selected file and submission status understandable.',image:d2l,alt:'Original D2L team selected-file review interface'},{n:'02',title:'Apple Ring',theme:'Possibility',target:'chapter-ring',case:'/work/apple-ring/',text:'Explore an overnight partnership between Ring, Watch and iPhone.',image:ring.product.image,alt:ring.product.alt},{n:'03',title:'Community Spaces',theme:'Connection',target:'chapter-community',case:'/work/community-spaces/',text:'Connect a proposed shared place with a way to discover and join activities.',image:community.details.image,alt:community.details.alt},{n:'04',title:'ALIGN',theme:'Decision-making',target:'chapter-align',case:'/work/align/',text:'Keep listing facts, preferences and unknowns distinct before committing.',image:summary,alt:'Historical ALIGN M05 decision brief; fictional listing and candidate data'}];
const figma='https://www.figma.com/proto/pWjqzjZD2HgayCk6pQg3Zk/Wireframes?page-id=154%3A64&node-id=214-348&starting-point-node-id=214%3A348&scaling=scale-down&content-scaling=fixed';
---
{selectionOnly && <section class="tme-selection" id="project-selection" tabindex="-1" aria-labelledby="perspectives-title">
 <header><div class="tme-selection-top"><p class="tme-eyebrow">Selected work / 01—04</p><a class="tme-chapter-link" href="#perspective" data-return>Introduction ↑</a></div><h2 id="perspectives-title">Four <em>perspectives.</em></h2></header>
 <div class="tme-exhibition">
 <ol class="tme-project-index" aria-label="Project previews and direct links">{projects.map((project,i)=><li data-project-preview={project.target} data-preview-active={i===0}>
  <p class="tme-index-category" id={`category-${project.target}`}>{project.n} / {project.theme}</p>
  <h3><button type="button" data-project-select={project.target} aria-label={`Preview ${project.title}`} aria-describedby={`category-${project.target}`} aria-controls={`preview-${project.target}`} aria-pressed={i===0} hidden><span>{project.title}</span><span class="tme-viewing" aria-hidden="true">Viewing</span></button><a class="tme-index-fallback" href={`#${project.target}`}>{project.title} ↗</a></h3>
  <div class="tme-project-quicklinks"><a href={`#${project.target}`} data-chapter-link aria-label={`Explore ${project.title} chapter`}>Explore ↗</a><a href={project.case} data-reader="case" data-title={`${project.title} — Case study`} aria-label={`Read ${project.title} case study`}>Case study ↗</a></div>
 </li>)}</ol>
 <div class="tme-selection-stage" role="group" aria-label="Selected project preview">{projects.map((project,i)=><figure id={`preview-${project.target}`} data-selection-visual={project.target} hidden={i!==0} aria-labelledby={`preview-title-${project.target}`}>
  <div class="tme-exhibit-art">{project.target==='chapter-community' ? <svg viewBox="49 97 296 621" role="img" aria-label="Original Community Spaces event-detail card, cropped from the full Figma screen"><image href={project.image.src} width="393" height="852" /></svg> : <img src={project.image.src} width={project.image.width} height={project.image.height} alt={project.alt} loading="lazy" decoding="async"/>}</div>
  <figcaption><p class="tme-eyebrow tme-selected-theme"><span>{project.n} /</span> <em>{project.theme}</em></p><h3 id={`preview-title-${project.target}`}><a href={`#${project.target}`} data-chapter-link>{project.title} <span aria-hidden="true">↗</span></a></h3><p>{project.text}</p><div class="tme-exhibit-actions"><a href={`#${project.target}`} data-chapter-link aria-label={`Enter ${project.title} experience`}>Explore project <span aria-hidden="true">↗</span></a><a href={project.case} data-reader="case" data-title={`${project.title} — Case study`} aria-label={`Open ${project.title} full case study`}>Full case study <span aria-hidden="true">↗</span></a></div>{project.target==='chapter-ring'&&<small>Independent speculative concept. Not affiliated with Apple.</small>}{project.target==='chapter-community'&&<small>Original team Figma artifact · Event-detail crop.</small>}{project.target==='chapter-align'&&<small>M05 historical exploration · The linked demo uses R05.</small>}</figcaption>
 </figure>)}</div>
 </div>
 <p class="tme-index-status" data-project-status role="status" aria-live="polite">Viewing D2L / Clarity.</p>
</section>}
{!selectionOnly && <>
<section class="tme-chapter tme-ring-chapter" id="chapter-ring" tabindex="-1" aria-labelledby="ring-chapter-title">
 <nav class="tme-chapter-bar" aria-label="Apple Ring chapter navigation"><a href="#project-selection" data-selection>← All perspectives</a><span>02 / Possibility</span><a href="#chapter-community" data-chapter-link>Connection →</a></nav>
 <header class="tme-ring-opening"><div><p class="tme-eyebrow">Apple Ring / Independent speculative concept</p><h2 id="ring-chapter-title">What happens<br/>when Watch<br/><em>comes off?</em></h2><p>The hypothesis: wear Ring overnight while Watch charges, then review the proposed handoff on Watch in the morning.</p><p class="tme-role-summary">Independent concept · Concept direction and critique; AI-assisted design and implementation.</p><p class="tme-chapter-boundary">Not commissioned by or affiliated with Apple. No real hardware integration.</p><div class="tme-opening-actions"><a class="tme-chapter-link" href="/prototypes/apple-ring/index.html#continuity" data-reader="prototype" data-title="Apple Ring — Independent speculative prototype" aria-label="Try the prototype — Explore the handoff">Try the prototype ↗</a><a class="tme-chapter-link" href="/work/apple-ring/" data-reader="case" data-title="Apple Ring — Case study">Read the case study ↗</a></div></div><RingChapterVideo /><details class="tme-opening-detail"><summary>Design decision and contribution</summary><p>An overnight-to-morning handoff explores a role for a ring alongside Watch. It is a product hypothesis, not a proven customer need.</p><p class="tme-opening-role"><strong>My role / Independent concept</strong>Concept direction and critique, with AI-assisted design and implementation. <span>Decision: show source and last sync; withhold unavailable readings.</span></p></details></header>
 <div class="tme-ring-evidence"><div><p class="tme-eyebrow">The interaction question</p><h3>What can the<br/>interface <em>honestly show?</em></h3><p>The proposed companion identifies the estimate’s source and last sync. Incomplete or disconnected states withhold information instead of inventing a current reading.</p><p class="tme-artifact-instruction">Explore captures of the proposed Watch companion. All values are illustrative.</p><a class="tme-chapter-link" href="/prototypes/apple-ring/index.html#continuity" data-reader="prototype" data-title="Apple Ring — Independent speculative prototype">Try the coded handoff ↗</a></div><div class="tme-state-viewer" data-artifact-viewer><div class="tme-state-controls" role="group" aria-label="Ring prototype captures"><button type="button" aria-pressed="true" aria-controls="ring-capture-complete" data-artifact="ring-capture-complete">Handoff</button><button type="button" aria-pressed="false" aria-controls="ring-capture-missing" data-artifact="ring-capture-missing">Missing readings</button><button type="button" aria-pressed="false" aria-controls="ring-capture-offline" data-artifact="ring-capture-offline">Disconnected</button></div>{[{id:'complete',asset:ring.handoff},{id:'missing',asset:ring.missing},{id:'offline',asset:ring.disconnected}].map(({id,asset},i)=><figure id={`ring-capture-${id}`} hidden={i!==0}><>{id==='complete' ? <svg class="tme-watch-crop" viewBox="670 145 340 455" role="img" aria-label="Crop of the original proposed Watch companion: Ring source, estimated sleep, last-synced battery and sync time"><image href={asset.image.src} width="1120" height="1119" /></svg> : <img src={asset.image.src} width={asset.image.width} height={asset.image.height} alt={asset.alt} loading="lazy" decoding="async"/>}</><figcaption>{id==='complete' && 'Watch companion crop from the complete original capture. '}{asset.caption} {asset.source}. <a href={asset.image.src} target="_blank" rel="noopener noreferrer">View original capture (new tab) ↗</a></figcaption></figure>)}<p class="tme-reader-status" data-artifact-status role="status"></p></div></div>
 <footer class="tme-chapter-ending"><p><strong>My contribution</strong>Concept direction and iterative critique; AI-assisted strategy, writing, implementation and checks. Product stills are AI-generated.</p><div><a class="tme-chapter-link" href="/prototypes/apple-ring/index.html#continuity" data-reader="prototype" data-title="Apple Ring — Independent speculative prototype">Try the coded handoff ↗</a><a class="tme-chapter-link" href="/work/apple-ring/" data-reader="case" data-title="Apple Ring — Case study">Read the full case study ↗</a></div></footer>
</section>
<section class="tme-chapter tme-community-chapter" id="chapter-community" tabindex="-1" aria-labelledby="community-chapter-title">
 <nav class="tme-chapter-bar" aria-label="Community Spaces chapter navigation"><a href="#project-selection" data-selection>← All perspectives</a><span>03 / Connection</span><a href="#chapter-align" data-chapter-link>Decision-making →</a></nav>
 <div class="tme-community-story"> <header class="tme-community-opening"><p class="tme-eyebrow">Community Spaces / Collaborative academic concept</p><h2 id="community-chapter-title">A place to gather.<br/><em>A way to join.</em></h2><p>KIBS connects a shared-space proposal with event discovery and registration for students and community members.</p><p class="tme-role-summary">Shared academic work · Research, concept development and interaction design.</p><div class="tme-opening-actions"><a class="tme-chapter-link tme-primary-action" href={figma} target="_blank" rel="noopener noreferrer">Try the prototype <span class="sr-only"> — Original Figma (new tab)</span>↗</a><a class="tme-chapter-link" href="/work/community-spaces/" data-reader="case" data-title="Community Spaces — Case study">Read the case study ↗</a></div></header><CommunityChapterVideo /><details class="tme-opening-detail"><summary>Design decision and contribution</summary><p>The team’s shared-space proposal pairs physical gathering areas with KIBS, an event-discovery and registration app concept for students and community members.</p><p class="tme-opening-role"><strong>My role / Shared academic work</strong>Research, concept development, interaction design and presentation with the team. <span>Decision: present event details before asking someone to reserve a place.</span></p></details></div><div class="tme-state-viewer" id="community-experience" data-artifact-viewer><p class="tme-eyebrow">Find an activity / Original Figma screens</p><div class="tme-state-controls" role="group" aria-label="Community Spaces original screens">{[{id:'events',label:'Discover'},{id:'details',label:'Details'},{id:'reservation',label:'Reserve'},{id:'confirmation',label:'Confirmation'}].map(({id,label},i)=><button type="button" aria-pressed={i===0} aria-controls={`community-capture-${id}`} data-artifact={`community-capture-${id}`}>{label}</button>)}</div>{[{id:'events',asset:community.events},{id:'details',asset:community.details},{id:'reservation',asset:community.reservation},{id:'confirmation',asset:community.confirmation}].map(({id,asset},i)=><figure id={`community-capture-${id}`} hidden={i!==0}><img src={asset.image.src} width={asset.image.width} height={asset.image.height} alt={asset.alt} loading="lazy" decoding="async"/><figcaption>{asset.caption} {asset.source}. This screen is an original artifact, not a live reservation.</figcaption></figure>)}<p class="tme-reader-status" data-artifact-status role="status"></p></div>
 <footer class="tme-chapter-ending"><p><strong>Shared contribution</strong>Research, concept development, interaction design and presentation with Katelyn Jewett, Illiana Gonzalez and Boran Erdogan. Proposed service; no launched space or measured attendance outcome.</p><div><a class="tme-chapter-link" href={figma} target="_blank" rel="noopener noreferrer">Open original Figma prototype (new tab) ↗</a><a class="tme-chapter-link" href="/work/community-spaces/" data-reader="case" data-title="Community Spaces — Case study">Read the full case study ↗</a></div></footer>
</section>
<section class="tme-chapter tme-align-chapter" id="chapter-align" tabindex="-1" aria-labelledby="align-chapter-title">
 <nav class="tme-chapter-bar" aria-label="ALIGN chapter navigation"><a href="#project-selection" data-selection>← All perspectives</a><span>04 / Decision-making</span><a href="#perspective" data-return>Character ↑</a></nav>
 <header class="tme-align-opening"><div><p class="tme-eyebrow">ALIGN / Independent AI-assisted concept</p><h2 id="align-chapter-title">A match is<br/>a claim.<br/><em>Show the evidence.</em></h2><p>A job-discovery prototype that separates listing facts, candidate preferences and unknowns.</p><p class="tme-role-summary">Independent AI-assisted concept · Product direction and iterative feedback.</p><p class="tme-chapter-boundary">Fictional listings and candidate data. No real application delivery or employer participation.</p><div class="tme-opening-actions"><a class="tme-chapter-link" href="/prototypes/align/demo/index.html?preview=1" data-reader="prototype" data-title="ALIGN — Fictional, memory-only candidate prototype" aria-label="Try the prototype — Explore the candidate journey">Try the prototype ↗</a><a class="tme-chapter-link" href="/work/align/" data-reader="case" data-title="ALIGN — Case study">Read the case study ↗</a></div></div><AlignChapterVideo /><details class="tme-opening-detail"><summary>Design decision and contribution</summary><p>A responsive job-discovery prototype separates listing facts, candidate preferences and unknowns before application review. The premise comes from the brief, not participant research.</p><p class="tme-opening-role"><strong>My role / Independent AI-assisted concept</strong>Product direction and iterative feedback; AI-assisted design and implementation. <span>Decision: keep listing facts, candidate preferences and unknowns distinct.</span></p></details></header>
 <div class="tme-align-principles"><div><span>01 / Conditions</span><h3>Facts stay facts.</h3><p>Listing conditions stay separate from the candidate’s preferences.</p></div><div><span>02 / Evidence</span><h3>Claims have sources.</h3><p>A self-declared qualification is not verified evidence.</p></div><div><span>03 / Unknowns</span><h3>Missing stays visible.</h3><p>Missing seniority is shown as not specified, rather than inferred from a title.</p></div></div>
 <details class="tme-align-artifacts"><summary>Explore the original comparison and responsive discovery artifacts</summary><div><figure><img src={summary.src} width={summary.width} height={summary.height} alt="Historical M05 ALIGN Summary + evidence alternative showing preference chips, qualification evidence, potential gaps and unknown information" loading="lazy" decoding="async"/><figcaption>M05 Summary + evidence · Historical exploration. <a href="/prototypes/align/demo/index.html?preview=1" data-reader="prototype" data-title="ALIGN — Fictional, memory-only candidate prototype">Try the current R05 candidate journey ↗</a></figcaption></figure><figure><img src={comparison.src} width={comparison.width} height={comparison.height} alt="Historical R03 responsive ALIGN comparison artifact using consistent arrangement labels and criteria" loading="lazy" decoding="async"/><figcaption>R03 comparison · Historical capture; fictional roles.</figcaption></figure><figure><img src={discovery.src} width={discovery.width} height={discovery.height} alt="Historical M06 ALIGN mobile and desktop discovery layouts" loading="lazy" decoding="async"/><figcaption>M06 discovery · Original responsive capture. Linked demo uses R05.</figcaption></figure></div></details>
 <footer class="tme-chapter-ending"><p><strong>My contribution</strong>Product direction and iterative feedback. AI-assisted design exploration, documentation, implementation and checks. No market validation or independent participant results are claimed.</p><div><a class="tme-chapter-link" href="/prototypes/align/demo/index.html?preview=1" data-reader="prototype" data-title="ALIGN — Fictional, memory-only candidate prototype">Try the candidate journey ↗</a><a class="tme-chapter-link" href="/work/align/" data-reader="case" data-title="ALIGN — Case study">Read the full case study ↗</a></div></footer>
 <div class="tme-journey-close"><ClosingBio /><h3>Let’s work<br/><em>together.</em></h3><p class="tme-local-time">Michigan <span aria-hidden="true">·</span> <time data-michigan-time>Eastern Time</time></p><p class="tme-recruiting-copy">Get in touch about UX and Product Design opportunities.</p><div class="tme-recruiting-links">{site.email && <a class="tme-chapter-link tme-contact-primary" href={`mailto:${site.email}`}>Email me ↗</a>}{site.resumeHref && <a class="tme-chapter-link" href={site.resumeHref}>View résumé (PDF) ↗</a>}{site.linkedIn && <a class="tme-chapter-link" href={site.linkedIn} target="_blank" rel="noopener noreferrer">LinkedIn (new tab) ↗</a>}<a class="tme-chapter-link" href="#project-selection" data-selection>All perspectives ↑</a></div></div>
</section>
<dialog class="tme-project-reader" aria-labelledby="tme-reader-title" data-project-reader><header><h2 id="tme-reader-title"></h2><div><a data-reader-standalone aria-label="Open project standalone (new tab)" href="/" target="_blank" rel="noopener noreferrer">Open standalone ↗</a><button type="button" data-reader-close autofocus>Close reader</button></div></header><p class="tme-reader-status" role="status" data-reader-loading></p><div data-reader-frame></div></dialog>
</>}
