---
import SectionHeading from './SectionHeading.astro';
const principles = [
  { title: 'Understand the problem.', body: 'In D2L, heuristic observations connect location, file selection, and rubric structure to specific interface questions.' },
  { title: 'Structure the experience.', body: 'Community Spaces connects a physical setting with the digital task of finding an event and reviewing participation.' },
  { title: 'Consider how it works.', body: 'Apple Ring makes source, sync, and missing-data behavior inspectable in a working web prototype.' },
];
---
<section id="approach" class="section" aria-labelledby="approach-heading">
  <SectionHeading number="02" title="Design approach" id="approach-heading" note="Evaluation / Structure / Interaction" />
  <div class="approach-grid">{principles.map((item, i) => <div class="approach-item"><span class="micro">0{i + 1}</span><h3>{item.title}</h3><p>{item.body}</p></div>)}</div>
</section>
