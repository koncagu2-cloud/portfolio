---
import { getCollection, getEntry } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import D2LFeature from './D2LFeature.astro';
import CommunitySpacesFeature from './CommunitySpacesFeature.astro';
import AppleRingFeature from './AppleRingFeature.astro';
import AlignFeature from './AlignFeature.astro';
import '../styles/case-study.css';
// Explicitly selected review case studies; drafts remain unfeatured.
const projects = await getCollection('projects', ({ data }) => data.publicationStatus === 'review' && Boolean(data.caseStudy));
const align = await getEntry('projects', 'align');
const d2l = projects.find(project => project.id === 'd2l');
const community = projects.find(project => project.id === 'community-spaces');
const ring = projects.find(project => project.id === 'apple-ring');
---
<section id="work" class="section" aria-labelledby="work-heading">
  <SectionHeading number="01" title="Selected work" id="work-heading"  />
  {d2l && <D2LFeature project={d2l} />}
  {community && <CommunitySpacesFeature project={community} />}
  {ring && <AppleRingFeature project={ring} />}
  {align?.data.publicationStatus === 'review' && <AlignFeature />}
</section>
