---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; number: number }
const { project, number } = Astro.props;
const { data } = project;
---
<article class="project-row" aria-labelledby={`project-${project.id}`}>
  <span class="micro project-index" aria-hidden="true">{String(number).padStart(2, '0')}</span>
  <div class="project-main">
    <p class="micro">{data.category}</p>
    <h3 id={`project-${project.id}`}>{data.title}</h3>
    <p>{data.provisionalSummary}</p>
    {project.id === 'd2l' && data.caseStudy && <a class="text-link" href={`${import.meta.env.BASE_URL}work/${data.caseStudy.slug}/`}>Read the D2L case study <span aria-hidden="true">↗</span></a>}
    <details>
      <summary>What’s still under review?</summary>
      <div class="review-details"><slot /></div>
    </details>
  </div>
  <div class="project-status"><span class="status-label">{data.caseStudy ? 'Review case study' : 'Provisional candidate'}</span><p>{data.caseStudy ? 'Original team artifacts' : <>Artifact withheld<br />pending verification.</>}</p><span class="micro">{data.caseStudy ? 'Concept / not launched' : 'Case study not published'}</span></div>
</article>
