---
import type { JourneyStep } from './journey';
import { Image } from 'astro:assets';
import { imageWidths } from './imageWidths';
import '../../styles/guided-journey.css';
interface Props { steps: JourneyStep[]; fileKey: string; navLabel: string; fileName?: string; layout?: 'desktop' | 'portrait' }
const { steps, fileKey, navLabel, fileName = 'Project', layout = 'desktop' } = Astro.props;
---
<guided-journey class:list={['student-journey', { 'journey-portrait': layout === 'portrait' }]}>
  <p class="micro journey-label">Annotated walkthrough · Original screens</p>
  <p class="journey-instruction">Choose a screen. Pictured controls are not interactive.</p>
  <nav class="journey-static-nav" aria-label={navLabel} data-static-links>
    <ol>{steps.map(step => <li><a href={`#journey-${step.id}`}>{step.number} / {step.label}</a></li>)}</ol>
  </nav>
  <div class="journey-controls" data-guided-controls hidden>
    <ol class="journey-steps" aria-label="Choose a walkthrough step">{steps.map(step => <li><button type="button" data-step-target={step.id} data-step-label={step.label} aria-controls={`journey-${step.id}`}><span aria-hidden="true">{step.number}</span>{step.label}</button></li>)}</ol>
    <div class="journey-toolbar"><p data-progress role="status" aria-live="polite" aria-atomic="true">Step 1 of {steps.length}: {steps[0].label}</p><div class="journey-reading-actions"><a class="journey-result-link" data-view-result href={`#journey-${steps[0].id}`}>View selected screen <span aria-hidden="true">↓</span></a><button type="button" class="journey-mode" data-read-all aria-pressed="false">Read all steps</button></div></div>
  </div>
  <div class="journey-panels">
    {steps.map(step => <section id={`journey-${step.id}`} class="journey-panel" data-step={step.id} aria-labelledby={`journey-${step.id}-heading`}>
      <header class="journey-panel-heading"><p class="micro">{step.number} / {step.label}</p><h3 id={`journey-${step.id}-heading`} tabindex="-1">{step.title}</h3></header>
      <figure class="artifact-figure journey-figure">
        <div class="journey-image"><Image src={step.asset.image} widths={imageWidths(step.asset.image.width)} sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 84vw, 70vw" format="webp" alt={step.asset.alt} loading="lazy" decoding="async" /><div class="journey-markers" aria-hidden="true" hidden>{step.annotations.map((note, index) => <span style={`--marker-x:${note.x}%;--marker-y:${note.y}%`}>{index + 1}</span>)}</div></div>
        <figcaption><span>{step.asset.caption}</span><span class="journey-source-links"><a href={step.asset.image.src}>Open full-size {step.asset.name}{layout === 'portrait' && ` · ${step.label}`}</a><a href={`https://www.figma.com/design/${fileKey}/${fileName}?node-id=${step.node.replace(':', '-')}`}>Original Figma · {step.node}</a></span></figcaption>
      </figure>
      <div class="journey-copy">

        <p><strong>User task.</strong> {step.task}</p><p><strong>Design response.</strong> {step.decision}</p><p class="journey-context">{step.context}</p>
        <details class="journey-annotations"><summary>Show design annotations</summary><ol>{step.annotations.map(note => <li><strong>{note.title}.</strong> {note.text}</li>)}</ol></details>
        <a class="journey-finding" href={`#${step.finding}`}>{step.findingLabel} →</a>
      </div>

    </section>)}
  </div>
</guided-journey>
<script>
  class GuidedJourney extends HTMLElement {
    private controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const panels = [...this.querySelectorAll<HTMLElement>('[data-step]')];
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('[data-step-target]')];
      const readAll = this.querySelector<HTMLButtonElement>('[data-read-all]');
      const progress = this.querySelector<HTMLElement>('[data-progress]');
      const controls = this.querySelector<HTMLElement>('[data-guided-controls]');
      const viewResult = this.querySelector<HTMLAnchorElement>('[data-view-result]');
      if (!panels.length || !readAll || !progress || !controls) return;
      let active = 0, all = false;
      const render = () => {
        this.dataset.mode = all ? 'all' : 'guided';
        panels.forEach((panel, index) => { panel.hidden = !all && index !== active; });
        buttons.forEach((button, index) => { if (index === active) button.setAttribute('aria-current', 'step'); else button.removeAttribute('aria-current'); });
        readAll.setAttribute('aria-pressed', String(all));
        viewResult?.setAttribute('href', `#${panels[active].id}`);
        progress.textContent = all ? `All ${panels.length} original interface states` : `Step ${active + 1} of ${panels.length}: ${buttons[active].dataset.stepLabel}`;
      };
      const revealHash = (moveFocus: boolean) => {
        const target = document.getElementById(window.location.hash.slice(1));
        const index = panels.findIndex(panel => target === panel || (!!target && panel.contains(target)));
        if (index < 0) return;
        active = index; render();
        if (moveFocus) {
          panels[index].querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
          panels[index].scrollIntoView({ block: 'start', behavior: 'auto' });
        }
      };
      buttons.forEach((button, index) => button.addEventListener('click', () => {
        active = index; all = false; render();
        // Replace, rather than append, so exploring steps does not flood browser history.
        history.replaceState(history.state, '', `#${panels[active].id}`);
      }, { signal }));
      // Re-activating the current fragment emits no hashchange; still reveal and focus its result.
      viewResult?.addEventListener('click', event => {
        event.preventDefault();
        if (location.hash !== `#${panels[active].id}`) history.pushState(history.state, '', `#${panels[active].id}`);
        revealHash(true);
      }, { signal });
      readAll.addEventListener('click', () => { all = !all; render(); }, { signal });
      panels.forEach(panel => {
        const details = panel.querySelector<HTMLDetailsElement>('details');
        const markers = panel.querySelector<HTMLElement>('.journey-markers');
        details?.addEventListener('toggle', () => { if (markers) markers.hidden = !details.open; }, { signal });
      });
      window.addEventListener('hashchange', () => revealHash(true), { signal });
      render(); revealHash(false);
      this.querySelector<HTMLElement>('[data-static-links]')?.setAttribute('hidden', '');
      controls.hidden = false;
    }
    disconnectedCallback() { this.controller?.abort(); }
  }
  if (!customElements.get('guided-journey')) customElements.define('guided-journey', GuidedJourney);
</script>
