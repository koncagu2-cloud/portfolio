---
interface ProjectLink { slug: string; title: string; description: string }
interface Props { previous?: ProjectLink; next?: ProjectLink }
const { previous, next } = Astro.props;
const root = import.meta.env.BASE_URL;
---
<nav class:list={['next-project', { 'has-previous': previous, 'has-next': next }]} aria-label="More case studies">
  {previous && <div class="project-neighbor project-neighbor-previous"><p class="micro">Previous case study</p><h2>{previous.title}</h2><p>{previous.description}</p><a class="text-link" href={`${root}work/${previous.slug}/`}><span aria-hidden="true">←</span> Previous project</a></div>}
  {next && <div class="project-neighbor project-neighbor-next"><p class="micro">Next case study</p><h2>{next.title}</h2><p>{next.description}</p><a class="text-link" href={`${root}work/${next.slug}/`}>Next project <span aria-hidden="true">→</span></a></div>}
</nav>
