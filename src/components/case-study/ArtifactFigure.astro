---
import type { Artifact } from './artifact';
import { Image } from 'astro:assets';
import { imageWidths } from './imageWidths';
interface Props {
  asset: Artifact;
  screen?: boolean;
  eager?: boolean;
  context?: string;
}
const { asset, screen = false, eager = false, context } = Astro.props;
const widths = imageWidths(asset.image.width);
---
<figure class:list={['artifact-figure', { 'artifact-screen': screen }]}>
  <div class="artifact-mat"><Image src={asset.image} widths={widths} sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 84vw, 70vw" format="webp" alt={asset.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>
  <figcaption><span class="artifact-caption">{asset.caption}</span>{asset.decision && <span class="artifact-decision"><strong>Design detail.</strong> {asset.decision}</span>}<span class="artifact-source">{asset.source}</span><a href={asset.image.src}>Open full-size {asset.name}{context && ` · ${context}`}</a></figcaption>
</figure>
